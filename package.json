{
  "name": "server",
  "version": "1.0.0",
  "description": "Blogify Blog Platform Backend API",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "seed": "node scripts/seed.js",
    "seed:regions": "node scripts/seedRegions.js",
    "migrate:multilingual": "node scripts/migrateToMultilingual.js",
    "migrate:passwords": "node scripts/migratePasswords.js",
    "migrate:tenant:articles": "node scripts/migrateArticlesToTenant.js",
    "migrate:tenant:content": "node scripts/migrateCategoriesAuthorsToTenant.js",
    "analyze:translations": "node scripts/analyzeTranslations.js",
    "check:categories": "node scripts/checkCategoryTranslations.js",
    "check:article-seo": "node scripts/checkArticleSeo.js",
    "audit:keywords": "node scripts/auditArticleKeywords.js",
    "check:category-lang": "node scripts/fixCategoryDefaultLanguage.js",
    "fix:category-lang": "node scripts/fixCategoryDefaultLanguage.js --fix",
    "setup:bloomwik": "node scripts/setupBloomwikTenant.js",
    "setup:tenants": "node scripts/ensureMultiTenantSetup.js",
    "setup:hostinger": "node scripts/setupHostingerTenant.js",
    "split:articles-by-tenant": "node scripts/splitArticlesByTenant.js",
    "assign:articles-by-tenant": "node scripts/assignArticlesByTenant.js",
    "backfill:tenant-scope": "node scripts/backfillTenantScopedRecords.js",
    "seed:bloomwik-seo": "node scripts/seedBloomwikSeo.js",
    "indexnow:submit": "node scripts/submitIndexNowBulk.js",
    "backfill:article-seo": "node scripts/backfillArticleSeo.js",
    "backfill:article-canonicals": "node scripts/backfillArticleCanonicalUrls.js",
    "sync:seo-settings": "node scripts/syncSeoSettingsFromSources.js",
    "prerender:pages": "node -e \"require('dotenv').config(); const m=require('./utils/prerenderPages'); const mongoose=require('mongoose'); mongoose.connect(process.env.MONGO_URL).then(async()=>{const d=await m.buildPrerenderPages(); console.log(JSON.stringify(d.stats)); await mongoose.disconnect();});\"",
    "verify:golive": "node scripts/verifyGoLive.js",
    "check:ids": "node scripts/checkMongoIds.js",
    "test": "NODE_ENV=test jest --coverage",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "cloudinary": "^1.40.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.10.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.4"
  },
  "author": "",
  "license": "ISC"
}
